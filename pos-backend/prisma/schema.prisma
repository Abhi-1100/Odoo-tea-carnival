// Prisma Schema for Odoo POS Cafe

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  admin
  cashier
  kitchen_staff
}

enum TableStatus {
  available
  occupied
  reserved
}

enum SessionStatus {
  open
  closed
}

enum OrderType {
  dine_in
  self_order
  takeaway
}

enum OrderStatus {
  draft
  confirmed
  sent_to_kitchen
  completed
  cancelled
}

enum PaymentMethodType {
  cash
  digital
  upi
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded
}

enum KitchenStage {
  to_cook
  preparing
  completed
}

// ============================================
// MODELS
// ============================================

model User {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash")
  role         UserRole     @default(cashier)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions     PosSession[]
  orders       Order[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String           @db.VarChar(150)
  categoryId    Int?             @map("category_id")
  price         Decimal          @db.Decimal(10, 2)
  unit          String           @default("piece") @db.VarChar(50)
  taxPercent    Decimal          @default(0.00) @map("tax_percent") @db.Decimal(5, 2)
  description   String?
  sendToKitchen Boolean          @default(true) @map("send_to_kitchen")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([categoryId], name: "idx_products_category")
  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  attribute  String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  extraPrice Decimal  @default(0.00) @map("extra_price") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model PaymentMethod {
  id        Int               @id @default(autoincrement())
  name      String            @unique @db.VarChar(50)
  type      PaymentMethodType
  isEnabled Boolean           @default(true) @map("is_enabled")
  upiId     String?           @map("upi_id") @db.VarChar(100)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  payments  Payment[]

  @@map("payment_methods")
}

model Floor {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tables    Table[]

  @@map("floors")
}

model Table {
  id                  Int         @id @default(autoincrement())
  floorId             Int         @map("floor_id")
  tableNumber         String      @map("table_number") @db.VarChar(20)
  seats               Int         @default(2)
  status              TableStatus @default(available)
  appointmentResource String?     @map("appointment_resource") @db.VarChar(100)
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  floor               Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  orders              Order[]
  selfOrderTokens     SelfOrderToken[]

  @@index([floorId], name: "idx_tables_floor")
  @@map("tables")
}

model PosSession {
  id           Int           @id @default(autoincrement())
  terminalName String        @map("terminal_name") @db.VarChar(100)
  openedBy     Int           @map("opened_by")
  openingCash  Decimal       @default(0.00) @map("opening_cash") @db.Decimal(10, 2)
  closingCash  Decimal?      @map("closing_cash") @db.Decimal(10, 2)
  totalSales   Decimal       @default(0.00) @map("total_sales") @db.Decimal(10, 2)
  status       SessionStatus @default(open)
  openedAt     DateTime      @default(now()) @map("opened_at")
  closedAt     DateTime?     @map("closed_at")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")

  user             User             @relation(fields: [openedBy], references: [id])
  orders           Order[]
  selfOrderTokens  SelfOrderToken[]

  @@index([status], name: "idx_pos_sessions_status")
  @@map("pos_sessions")
}

model SelfOrderToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(100)
  tableId   Int       @map("table_id")
  sessionId Int       @map("session_id")
  isUsed    Boolean   @default(false) @map("is_used")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  table     Table      @relation(fields: [tableId], references: [id])
  session   PosSession @relation(fields: [sessionId], references: [id])
  orders    Order[]

  @@index([token], name: "idx_self_order_tokens_token")
  @@map("self_order_tokens")
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique @map("order_number") @db.VarChar(30)
  sessionId        Int         @map("session_id")
  tableId          Int?        @map("table_id")
  createdBy        Int?        @map("created_by")
  selfOrderTokenId Int?        @map("self_order_token_id")
  orderType        OrderType   @default(dine_in) @map("order_type")
  status           OrderStatus @default(draft)
  subtotal         Decimal     @default(0.00) @db.Decimal(10, 2)
  taxAmount        Decimal     @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount      Decimal     @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  session          PosSession      @relation(fields: [sessionId], references: [id])
  table            Table?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdByUser    User?           @relation(fields: [createdBy], references: [id])
  selfOrderToken   SelfOrderToken? @relation(fields: [selfOrderTokenId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  kitchenTickets   KitchenTicket[]

  @@index([sessionId], name: "idx_orders_session")
  @@index([tableId], name: "idx_orders_table")
  @@index([status], name: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  variantId Int?     @map("variant_id")
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @default(0.00) @map("line_total") @db.Decimal(10, 2)
  notes     String?
  isPrepared Boolean @default(false) @map("is_prepared")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])
  kitchenTicketItems KitchenTicketItem[]

  @@index([orderId], name: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  paymentMethodId Int           @map("payment_method_id")
  amountPaid      Decimal       @map("amount_paid") @db.Decimal(10, 2)
  changeAmount    Decimal       @default(0.00) @map("change_amount") @db.Decimal(10, 2)
  upiRef          String?       @map("upi_ref") @db.VarChar(100)
  receiptNumber   String        @unique @map("receipt_number") @db.VarChar(50)
  status          PaymentStatus @default(pending)
  paidAt          DateTime      @default(now()) @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  order         Order         @relation(fields: [orderId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([orderId], name: "idx_payments_order")
  @@map("payments")
}

model KitchenTicket {
  id           Int          @id @default(autoincrement())
  orderId      Int          @map("order_id")
  ticketNumber String       @map("ticket_number") @db.VarChar(30)
  stage        KitchenStage @default(to_cook)
  sentAt       DateTime     @default(now()) @map("sent_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  order Order               @relation(fields: [orderId], references: [id])
  items KitchenTicketItem[]

  @@index([orderId], name: "idx_kitchen_tickets_order")
  @@index([stage], name: "idx_kitchen_tickets_stage")
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  orderItemId Int      @map("order_item_id")
  productName String   @map("product_name") @db.VarChar(150)
  variantInfo String?  @map("variant_info") @db.VarChar(150)
  quantity    Int
  notes       String?
  isPrepared  Boolean  @default(false) @map("is_prepared")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("kitchen_ticket_items")
}
