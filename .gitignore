# Root .gitignore to exclude dependencies and build artifacts

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next/
out/

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/

# OS files
.DS_Store
Thumbs.db

# TypeScript
tsbuildinfo

# IDE files
.vscode/
.idea/
.swp
*.sublime-project
*.sublime-workspace
